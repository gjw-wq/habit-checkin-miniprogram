/* 项目信息卡片 */
.info-card {
  position: relative;
  padding-top: 48rpx;
}

.delete-entry {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 24rpx;
  color: #FA5151;
  padding: 8rpx 16rpx;
  border: 2rpx solid #FA5151;
  border-radius: 24rpx;
}

.info-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-right: 160rpx;
}

.info-stats {
  display: flex;
  margin-top: 28rpx;
}

.info-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #07C160;
}

.info-stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
}

.progress-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
  text-align: right;
}

/* 统计网格 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 24rpx;
}

.stat-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.stat-cell-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.stat-cell-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 日历 */
.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.calendar-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #576B95;
  border-radius: 50%;
  background: #F4F6F9;
}

.calendar-arrow.disabled {
  color: #CCCCCC;
}

.calendar-arrow:active {
  opacity: 0.7;
}

.calendar-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.calendar-weekday {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 12rpx;
}

.calendar-day {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333333;
  border-radius: 50%;
  margin: 0 auto;
  width: 76rpx;
  box-sizing: border-box;
  border: 4rpx solid transparent;
}

.calendar-day.blank {
  background: transparent;
}

/* 已打卡：绿色背景 */
.calendar-day.checked {
  background: #07C160;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.3);
}

/* 今天：蓝色边框 */
.calendar-day.today {
  border-color: #576B95;
  color: #576B95;
  font-weight: 700;
}

.calendar-day.today.checked {
  color: #ffffff;
}

/* 未来日期：低透明度 */
.calendar-day.future {
  opacity: 0.35;
}

/* 图例 */
.calendar-legend {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999999;
  margin: 0 24rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.legend-green {
  background: #07C160;
}

.legend-blue {
  background: #ffffff;
  border: 3rpx solid #576B95;
  box-sizing: border-box;
}

/* 打卡按钮 */
.checkin-area {
  margin: 8rpx 32rpx 0;
}

.checkin-btn {
  padding: 24rpx 0;
}

/* 记录列表 */
.record-card {
  padding-bottom: 16rpx;
}

.record-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F5;
}

.record-row:last-child {
  border-bottom: none;
}

.record-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #07C160;
  margin: 12rpx 20rpx 0 8rpx;
  flex-shrink: 0;
}

.record-date {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.record-note {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999999;
}

.bottom-space {
  height: 80rpx;
}
